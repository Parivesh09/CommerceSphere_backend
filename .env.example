# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=<service>_service
DB_USER=commercesphere
DB_PASSWORD=commercesphere_dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=<service>-service

# Service Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration (Auth Service)
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Stripe Configuration (Payment Service)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid Configuration (Notification Service)
SENDGRID_API_KEY=SG...

# Twilio Configuration (Notification Service)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Elasticsearch Configuration (Search Service)
ELASTICSEARCH_NODE=http://localhost:9200

# AWS S3 Configuration (Product Service)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=commercesphere-products
