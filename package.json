{
  "name": "commercesphere",
  "version": "1.0.0",
  "description": "Production-grade microservices-based e-commerce platform",
  "private": true,
  "workspaces": [
    "services/auth",
    "services/gateway",
    "services/product",
    "services/order",
    "services/payment",
    "services/notification",
    "services/search",
    "services/analytics",
    "services/cart",
    "shared/types",
    "shared/utils",
    "tests/integration",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:down": "docker-compose down",
    "dev:clean": "docker-compose down -v",
    "setup:envs": "bash scripts/populate-envs.sh",
    "setup:local": "npm run setup:envs && bash scripts/setup.sh && npm run db:init",
    "setup": "npm run setup:local",
    "db:init": "bash scripts/init-db.sh",
    "db:seed": "bash scripts/seed-data.sh",
    "db:seed:v2": "node scripts/seed.mjs",
    "db:setup": "npm run db:init && npm run db:seed",
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "init:kafka": "ts-node scripts/init-kafka-topics.ts",
    "test:integration": "cd tests/integration && npm test",
    "test:integration:setup": "cd tests/integration && npm install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "bcryptjs": "^3.0.3",
    "eslint": "^8.54.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
